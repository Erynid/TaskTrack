    border-color: #bbbfbf;
}

[data-theme="light"] .form-legend {
    color: #05ad98;
}

[data-theme="light"] .form-field label {
    color: #5e6b6c;
}

[data-theme="light"] .field-hint {
    color: #878787;
}

[data-theme="light"] .form-field input,
[data-theme="light"] .form-field select,
[data-theme="light"] .form-field textarea {
    background: #ffffff;
    border-color: #bbbfbf;
    color: #192223;
}

[data-theme="light"] .form-field input:focus,
[data-theme="light"] .form-field select:focus,
[data-theme="light"] .form-field textarea:focus {
    border-color: #05ad98;
    box-shadow: 0 0 0 3px rgba(5, 173, 152, 0.2);
}

[data-theme="light"] .form-error-summary {
    background: #fef2f2;
    border-color: #fca5a5;
}

[data-theme="light"] .error-summary-header,
[data-theme="light"] .error-summary-list li,
[data-theme="light"] .error-summary-list a {
    color: #b91c1c;
}

[data-theme="light"] .field-error-msg {
    color: #dc2626;
}

[data-theme="light"] .btn-preset-pill {
    background: #edf1f1;
    border-color: #bbbfbf;
    color: #5e6b6c;
}

[data-theme="light"] .btn-preset-pill:hover {
    background: rgba(5, 173, 152, 0.1);
    border-color: #05ad98;
    color: #05ad98;
}

[data-theme="light"] .btn-paste-clipboard {
