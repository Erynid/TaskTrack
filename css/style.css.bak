}

[data-theme="light"] .cal-cell {
    background: #ffffff;
    border-color: #bbbfbf;
}

[data-theme="light"] .cal-cell:hover {
    background: #edf1f1;
    border-color: #05ad98;
}

[data-theme="light"] .cal-cell-num {
    color: #192223;
    font-weight: 700;
}

[data-theme="light"] .cal-cell.today {
    background: rgba(5, 173, 152, 0.08);
    border-color: #05ad98;
}

[data-theme="light"] .cal-cell.today .cal-cell-num {
