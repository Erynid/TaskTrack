    border-color: rgba(5, 173, 152, 0.3);
    color: #05ad98;
}

[data-theme="light"] .btn-status-pill {
    background: #edf1f1;
    border-color: #bbbfbf;
    color: #5e6b6c;
}

[data-theme="light"] .btn-status-pill:hover {
