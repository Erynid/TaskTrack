}

[data-theme="light"] .btn-reset {
    background: #edf1f1;
    border-color: #bbbfbf;
    color: #5e6b6c;
}

[data-theme="light"] .btn-reset:hover {
    background: #bbbfbf;
    color: #192223;
}

[data-theme="light"] .form-keyboard-hint kbd {
    background: #edf1f1;
    border-color: #bbbfbf;
    color: #192223;
}

/* Calendar View (Angka Tanggal Tajam & Jelas) */
[data-theme="light"] .calendar-view-wrap {
    background: #ffffff;
    border-color: #bbbfbf;
}

[data-theme="light"] .calendar-header-nav h2 {
