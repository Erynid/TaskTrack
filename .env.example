APP_NAME=TaskTrack
APP_ENV=development
API_BASE_URL=http://localhost/tasktrack/api

# Konfigurasi Database (Tugas 10)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tasktrack_db
DB_USER=root
DB_PASS=

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/TaskTrack/auth/google-callback.php

# Mailer / SMTP Configuration (Kosongkan untuk otomatis fallback ke HTML Preview di folder data/mail_previews/)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@tasktrack.local
SMTP_FROM_NAME="TaskTrack Studio"
